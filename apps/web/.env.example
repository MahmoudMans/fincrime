# Copy to .env.local and adjust. All NEXT_PUBLIC_* values are compiled into
# the browser bundle at build time, so anything here is visible to every user.

# Base URL of the Spring Boot API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Keep the signed-in session across page refreshes (stored in sessionStorage,
# so it is cleared when the tab closes). Set to "false" to keep the access
# token in memory only; a refresh then returns to the sign-in screen.
NEXT_PUBLIC_PERSIST_SESSION=true

# Show the one-click demo accounts on the sign-in screen. Set to "false" for
# anything that is not a local demo; it also removes the pre-filled credentials.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true

# Environment pill shown in the top bar. Defaults to "Synthetic data" when the
# variable is not set at all; set it to an empty value to hide the pill, or to
# something like "Staging" / "UAT".
NEXT_PUBLIC_ENVIRONMENT_LABEL=Synthetic data
